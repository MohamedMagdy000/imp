
<odoo>
    <record id="view_vehicle_alert_tree" model="ir.ui.view">
        <field name="name">vehicle.vehicle.alert.tree</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <tree string="تنبيهات السيارات">
                <field name="name"/>
                <field name="plate_no"/>
                <field name="license_number"/>
                <field name="license_expiry_date"/>
                <field name="license_expires_soon"/>
                <field name="odometer_km"/>
                <field name="last_oil_change_km"/>
                <field name="oil_change_interval_km"/>
                <field name="next_oil_change_km"/>
                <field name="needs_oil_change"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_vehicle_alerts" model="ir.actions.act_window">
        <field name="name">تنبيهات (رخص/زيت)</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_vehicle_alert_tree"/>
        <field name="domain" eval="['|', ('license_expires_soon','=',True), ('needs_oil_change','=',True)]"/>
        <field name="context">{}</field>
    </record>
</odoo>
