
<odoo>
    <!-- Action & Views -->
    <record id="action_vehicle" model="ir.actions.act_window">
        <field name="name">السيارات</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">أضف أول عربية لك</p>
        </field>
    </record>

    <record id="view_vehicle_kanban" model="ir.ui.view">
        <field name="name">vehicle.vehicle.kanban</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state">
                <templates>
    <t t-name="kanban-box">
        <div class="oe_kanban_global_click o_kanban_card" style="position:relative; overflow:hidden;">
            <!-- الشريط الأحمر -->
            <t t-if="record.needs_oil_change.raw_value || record.license_expires_soon.raw_value">
                <div style="position:absolute; top:0; left:0; right:0; height:24px;
                            background:#D32F2F; color:#fff; display:flex; align-items:center;
                            gap:8px; padding:0 10px; font-weight:700; font-size:12px;">
    <t t-if="record.license_expires_soon.raw_value &amp;&amp; record.needs_oil_change.raw_value">
        <span>تجديد رخصة + تغيير زيت قريب</span>
    </t>
    <t t-if="record.license_expires_soon.raw_value &amp;&amp; !record.needs_oil_change.raw_value">
        <span>تجديد رخصة</span>
    </t>
    <t t-if="record.needs_oil_change.raw_value &amp;&amp; !record.license_expires_soon.raw_value">
        <span>تغيير زيت قريب</span>
    </t>
</div>
            </t>

            <div class="o_kanban_details" style="padding: 10px; padding-top: 36px;">
                <div class="o_kanban_record_headings" style="display:flex; justify-content:space-between; align-items:center;">
                    <strong t-esc="record.name.value"/>
                    <span class="o_tag o_tag_color_0" t-esc="record.state.value"/>
                </div>
                <div class="o_kanban_primary_right" style="margin-top:4px;">
                    <t t-if="record.price.value">
                        <span t-esc="record.price.value"/>
                        <t t-if="record.currency_id.value">
                            <span t-esc="record.currency_id.value[1]"/>
                        </t>
                    </t>
                    <t t-else=""><span>—</span></t>
                </div>
                <div class="o_kanban_tags" style="margin-top:6px;">
                    <span>VIN: <t t-esc="record.vin.value or '-'"/></span>
                    <span style="margin:0 6px;">|</span>
                    <span>لوحات: <t t-esc="record.plate_no.value or '-'"/></span>
                </div>
            </div>
        </div>
    </t>
</templates>
                <field name="name"/>
                <field name="vin"/>
                <field name="plate_no"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="needs_oil_change"/>
                <field name="license_expires_soon"/>
            </kanban>
        </field>
    </record>

    <record id="view_vehicle_tree" model="ir.ui.view">
        <field name="name">vehicle.vehicle.tree</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="vin"/>
                <field name="plate_no"/>
                <field name="model_year"/>
                <field name="color"/>
                <field name="state"/>
                <field name="needs_oil_change"/>
                <field name="license_expires_soon"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="extra_total"/>
                <field name="total_cost"/>
            </tree>
        </field>
    </record>

    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <form string="السيارات" class="o_form_full">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,sold,archived"/>
                    <button name="action_set_draft" type="object" string="مسودة" class="btn-secondary"/>
                    <button name="action_set_available" type="object" string="متاحة" class="btn-primary"/>
                    <button name="action_set_sold" type="object" string="مباعة" class="btn-primary"/>
                    <button name="action_set_archived" type="object" string="أرشفة" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="vin"/>
                            <field name="plate_no"/>
                            <field name="model_year"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="currency_id"/>
                            <field name="extra_total" readonly="1"/>
                            <field name="total_cost" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="تكاليف إضافية">
                            <field name="cost_line_ids" context="{'default_vehicle_id': active_id}">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="cost_type"/>
                                    <field name="description"/>
                                    <field name="vendor_bill"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="صيانة وتراخيص">
                            <group>
                                <group string="الترخيص/التأمين">
                                    <field name="license_number"/>
                                    <field name="license_expiry_date"/>
                                    <field name="insurance_expiry_date"/>
                                    <field name="inspection_expiry_date"/>
                                    <field name="license_expires_soon" readonly="1"/>
                                </group>
                                <group string="الزيت/الصيانة">
                                    <field name="odometer_km"/>
                                    <field name="last_oil_change_km"/>
                                    <field name="last_oil_change_date"/>
                                    <field name="oil_change_interval_km"/>
                                    <field name="next_oil_change_km" readonly="1"/>
                                    <field name="needs_oil_change" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
