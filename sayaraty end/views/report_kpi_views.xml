
<odoo>
    <record id="view_vehicle_report_kpi_kanban" model="ir.ui.view">
        <field name="name">vehicle.report.kpi.kanban</field>
        <field name="model">vehicle.report.kpi</field>
        <field name="arch" type="xml">
            <kanban create="false">
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record" t-attf-style="background: #{record.color_hex.value or '#BBDEFB'}; border-radius:14px; box-shadow: 0 4px 16px rgba(0,0,0,.08);">
                            <div class="o_kanban_details" style="padding:16px 18px;">
                                <div t-if="record.value.raw_value" style="font-size:26px; font-weight:800;" t-esc="record.value.value"/>
                                <div t-else="" style="font-size:26px; font-weight:800;" t-esc="record.value_int.value or 0"/>
                                <div style="opacity:.75; margin-top:6px; font-weight:600;" t-esc="record.name.value"/>
                            </div>
                        </div>
                    </t>
                </templates>
                <field name="name"/>
                <field name="value"/>
                <field name="value_int"/>
                <field name="color_hex"/>
            </kanban>
        </field>
    </record>

    <!-- Analysis: graph + pivot for vehicles -->
    <record id="view_vehicle_graph" model="ir.ui.view">
        <field name="name">vehicle.vehicle.graph</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <graph string="تحليل السيارات" type="bar">
                <field name="price" type="measure"/>
                <field name="state" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_vehicle_pivot" model="ir.ui.view">
        <field name="name">vehicle.vehicle.pivot</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <pivot string="تحليل السيارات">
                <field name="price" type="measure"/>
                <field name="state" type="row"/>
            </pivot>
        </field>
    </record>

    <record id="action_vehicle_analysis" model="ir.actions.act_window">
        <field name="name">تحليل</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">graph,pivot,tree</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'graph', 'view_id': ref('view_vehicle_graph')}), (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_vehicle_pivot')})]"/>
    </record>
<record id="action_vehicle_report_kpi" model="ir.actions.act_window">
            <field name="name">لوحة المؤشرات</field>
            <field name="res_model">vehicle.report.kpi</field>
            <field name="view_mode">kanban</field>
            <field name="target">current</field>
        </record>
</odoo>
